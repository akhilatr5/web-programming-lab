<html>
<head>
<title>registration form</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<h1><center>Registration form</center></h1>
<form><fieldset><legend>user information</legend>
<label for ="name">Name</label>
<select>
<option>Mr.</option>
<option>Mrs</option>
<option>Miss</option>
</select><input type="text" id="name"
required><br><br>
<label for="phone class="c3">Phone
<input type="tel" required></label>
<label>Email<input type="email"
required></label>
</fieldset><br><br>
</form>
<div class="row">
<label for="Address">Address</label>
<textarea id="Address" required></textarea><br><br>
</div>
<div class="row">
<label>Gender:</label>
<input type ="radio" name="gender" required><label>Male</label>
<input type ="radio" name="gender" required><label>Female</label>
<input type ="radio" name="gender" required><label>Other</label>
</div>
<div class="row">
<label>Languages known:</label>
<input type="checkbox"> English
<input type="checkbox"> Malayalam
<input type="checkbox"> Hindi
</div>
<div class="row">
<label>Course:</label>
<select required>
<option>course</option>
<option>BCA</option>
<option>MCA</option>
<option>BSC</option>
<option>BCOM</option>
</select>
</div>
<center>
<button type="reset">Reset</button>
<button type="submit">Submit</button>
</center>
</form>
</body>
</html>


